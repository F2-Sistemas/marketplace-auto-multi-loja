APP_NAME="AutoHub Central API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://api.rederevenda.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=172.17.0.1
DB_PORT=1010
DB_DATABASE=dev_rede_revendas_marketplace
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Database configuration aliases from project spec
DATABASE_CONNECTION=pgsql
DATABASE_HOST=172.17.0.1
DATABASE_PORT=1010
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_DATABASE=dev_rede_revendas_marketplace
DATABASE_TEST_DATABASE=dev_rede_revendas_marketplace_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.rederevenda.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3-uploads
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=autohub_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=172.17.0.1
REDIS_PASSWORD=
REDIS_PORT=1020

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@rederevenda.com"
MAIL_FROM_NAME="AutoHub Central"

AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=dev-auto-hub
AWS_ENDPOINT=http://127.0.0.1:9001
AWS_URL=http://127.0.0.1:9001/dev-auto-hub
AWS_USE_PATH_STYLE_ENDPOINT=true

# Technical domains for AutoHub Central spec
LOCAL_API_DOMAIN=api.rederevenda.com
LOCAL_PORTAL_DOMAIN=rederevenda.com
LOCAL_BACKOFFICE_DOMAIN=admin.rederevenda.com
LOCAL_STOREFRONT_BASE_DOMAIN=app-loja.rederevenda.com

